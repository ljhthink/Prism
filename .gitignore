# Android / Gradle
.gradle/
build/
*/build/
*.apk
*.aab
*.ap_
*.dex
local.properties
keystore/
*.keystore
*.jks

# Kotlin
*.kotlin_metadata
.kotlin/

# ObjectBox JNI 本地库（BR-build-004，构建期下载，不入版本控制）
app/objectbox-jni-*.dll
app/objectbox-jni-*.so
app/objectbox-jni-*.dylib
app/objectbox-jni-*.jnilib

# ObjectBox schema 备份文件（生成器产物，不入版本控制）
# 注：default.json 必须入库（BR-build-005），仅排除 .bak 备份
app/objectbox-models/*.bak

# IDE
.idea/
*.iml
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Node（文档工具链）
node_modules/

# 运行时产物（CLAUDE.md 第二十节）
logs/
tmp/
temp/
.coverage/
.nyc_output/
dist/
out/
target/

# JVM 崩溃日志（native crash dumps，如 ObjectBox JNI 崩溃）
hs_err_pid*.log
replay_pid*.log
app/hs_err_pid*.log
app/replay_pid*.log

# 环境变量（CLAUDE.md 20.3，仅 .env.example 提交）
.env
.env.local
.env.*.local

# 性能/测试产物
perf/baselines/*.bin
.emulator/

# 一次性参考工件（CLAUDE.md 5.3 动态报告目录化）
# docs/reports/ 下的 *.md 为 guardrail / ac-verifier / archaeology 等一次性汇报，
# 不纳入长期手工维护，不提交远程（用户指示 2026-08-09）。
# 例外：docs/reports/README.md（目录说明，CLAUDE.md 14.1 要求）
# 注：docs/reports/perf/ 子目录不受影响（*.md 不递归匹配子目录）
docs/reports/*.md
!docs/reports/README.md

# 真机/模拟器采集运行时产物（CLAUDE.md 20.1，禁止入库；guardrail TKN-PREPUSH-V1-B1B7-001 4.1）
# 包括 logcat 捕获（*.log / *.err / PID 状态文件）、uiautomator UI dump（*.xml）、
# logcat 转储（*.txt）、截图（*.png）。
docs/reports/logcat/
docs/reports/*.xml
docs/reports/*.txt
docs/reports/*.png
