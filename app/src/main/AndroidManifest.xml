<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- US-006：SSE 流式请求 OpenAI 兼容端点需要网络权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v1 真机二次修复（Issue 5）：Prism 后台时手机操控高危确认（发送/删除/拨号）需发系统通知，
         Android 13+（targetSdk 34）为运行时权限，需在运行时申请（Settings 无障碍页/首次操控时提示）。 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 批次22 修复轮五：bg 操控会话期 SCREEN_BRIGHT_WAKE_LOCK（防任务中途息屏丢虚拟屏注入） -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- v1 批次11（F2）：手机操控保活前台服务。Android 14+ 需要前台服务权限 + specialUse 声明用途。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 批次20（BG-005，ADR-045）：后台操控悬浮窗权限——系统对「后台启动 Activity」的官方豁免
         条件（虚拟屏后台启动目标 App 必需）；用户在设置/开关引导中手动授予（Settings.canDrawOverlays 判定）。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- 批次20（VC-001，ADR-044）：语音通话——录音（运行时申请）+ 麦克风前台服务类型（Android 14+ 强制）。 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 批次22 修复轮七：后台任务回收 killBackgroundProcesses 所需（normal 级权限；
         lint MissingPermission——批次20 起缺失，releaseDisplay 的非 Shizuku 回收路径必需）。 -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <application
        android:name=".PrismApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Prism">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Prism"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            v1 US-201（LLM 操控手机）：无障碍服务。
            读取 UI 树 + 注入手势/全局动作/无障碍截图（API30+），供 phone_control__* 工具使用。
            需用户在系统「设置 → 无障碍」中手动开启（Android 12+ 无法代码拉起授权页）。
        -->
        <service
            android:name=".phonecontrol.PhoneControlAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/phone_control_accessibility" />
        </service>
        <!-- v1 真机二次修复（Issue 5）：手机操控高危确认通知操作接收器（后台也能作答） -->
        <receiver
            android:name=".phonecontrol.PhoneControlAskUserNotifier$ConfirmActionReceiver"
            android:exported="false" />
        <!-- v1 批次11（F2）：手机操控保活前台服务（specialUse，防止 MIUI 回收操控进程） -->
        <service
            android:name=".phonecontrol.PhoneControlKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="LLM 手机操控任务期间保活，防止后台进程被系统回收导致任务中断" />
        </service>
        <!-- 批次20（VC-001，ADR-044）：语音通话前台服务（microphone 类型，锁屏/后台保持麦克风可用） -->
        <service
            android:name=".voice.VoiceForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- 批次24（ADR-051 D5）：桌宠悬浮窗前台服务。
             与 PhoneControlKeepAliveService 同用 specialUse——Android 14 起
             FOREGROUND_SERVICE_TYPE_NONE 会抛 InvalidForegroundServiceTypeException，
             而"在桌面上显示一个用户自己打开的窗口"不属于任何既有专用类型。
             本服务由用户在设置页显式开启，窗口本身可见，关闭开关即 stopSelf。 -->
        <service
            android:name=".pet.overlay.PetOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="用户主动开启的桌面宠物悬浮窗显示（可在应用内随时收起）" />
        </service>

        <!-- 批次21（SZ-001，ADR-046）：Shizuku Provider——shell 命令通道的授权与绑定入口 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

    <!--
        M6 跨 App 调用包可见性声明（US-039，ADR-016 5.3）。

        Android 11+（API 30+）默认限制包可见性，必须通过 <queries> 显式声明才能：
        1. 通过 PackageManager.getPackageInfo 检测目标 App 是否安装
        2. 通过 Intent.ACTION_VIEW + scheme 触发 Deep Link 跳转

        **合规策略**（ADR-016 R1 缓解）：
        - 仅声明 7 个目标 App 包名 + 7 个 scheme + 2 个 ACTION_SEND intent 过滤器
        - 不声明 QUERY_ALL_PACKAGES 权限（Google Play 政策禁止滥用）

        **包名清单**（对应 app_schemes.json packageName 字段）：
        - com.tencent.mm           微信
        - com.eg.android.AlipayGphone  支付宝
        - com.taobao.taobao        淘宝
        - com.ss.android.ugc.aweme 抖音
        - com.tencent.mobileqq     QQ
        - com.sina.weibo           微博
        - com.baidu.BaiduMap       百度地图

        **scheme 清单**（对应 app_schemes.json scheme 字段）：
        - weixin / alipay / taobao / snssdk1128 / mqq / sinaweibo / baidumap
    -->
    <queries>

        <!-- 7 个目标 App 包名（PackageManager 可见性） -->
        <package android:name="com.tencent.mm" />
        <package android:name="com.eg.android.AlipayGphone" />
        <package android:name="com.taobao.taobao" />
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="com.sina.weibo" />
        <package android:name="com.baidu.BaiduMap" />

        <!-- 7 个 scheme intent 过滤器（Deep Link 跳转可见性） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="weixin" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="alipay" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="taobao" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="snssdk1128" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="mqq" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sinaweibo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="baidumap" />
        </intent>

        <!-- 2 个 ACTION_SEND intent 过滤器（Share Sheet 可见性） -->
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>

        <!-- v1 US-201（LLM 操控手机）：launcher intent 包可见性（启动任意已装 App） -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!-- 批次20 真机修复（RCA 2026-09-05 问题2）：语音识别引擎包可见性。
             缺失时 SpeechRecognizer.isRecognitionAvailable 在 Android 11+ 恒为 false
             （MIUI 实证：com.xiaomi.mibrain.speech 引擎存在但被包可见性过滤），
             导致"按住说话无反应"。 -->
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>

    </queries>

</manifest>
